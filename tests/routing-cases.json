          "loaded_files": {"contains": ["yesh-mode/SKILL.md", "yesh-mode/playbooks/index.md", "how/SKILL.md"]},
          "actions": {"contains": ["select:how", "read:how"], "excludes": ["edit", "classifier_accept"]},
          "scope": {"equals": {"mode": "yesh-mode", "objective": "explain-request-path", "write_authority": "not-requested", "external_transmission": "denied"}}
        },
        "revised": {
